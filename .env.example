# SongScribe Environment Configuration
# Copy to .env for Docker Compose or customize for Cloud/Serverless GPU deployment.

# --- Database (PostgreSQL in Docker / Neon / RDS; SQLite supported for local fallback) ---
DATABASE_URL=postgresql+psycopg://songscribe:songscribe@postgres:5432/songscribe

# --- Queue & Progress Events (Redis in Docker / Upstash; "local" for DB-polling fallback) ---
QUEUE_BACKEND=celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Object Storage (MinIO locally, Cloudflare R2 or AWS S3 in cloud; "local" for filesystem) ---
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=./local_data/storage
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=songscribe
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Compute & ML Worker ---
# auto | cuda | mps | cpu
DEVICE=auto
MODEL_CACHE_DIR=/models
PIANO_MODEL_PATH=
DEMUCS_MODEL=htdemucs

# --- API & Frontend ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_MB=100
API_UPSTREAM=api:8000
